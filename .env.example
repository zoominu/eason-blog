# ============================================================
# 复制为 .env 后按需修改；.env 不入库。
# 本项目所有配置均可通过环境变量覆盖 application.yml 中的默认值。
# ============================================================

# ---- 后端 ----
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# ---- 数据库 ----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=eason_blog
DB_USER=blog
DB_PASSWORD=change-me-in-local-env

# 测试库（mvn test 使用）
TEST_DB_NAME=eason_blog_test

# ---- JWT ----
# 生产必须替换为 >= 32 字节的随机串：openssl rand -base64 48
JWT_SECRET=dev-only-change-me-please-32bytes-minimum-secret
JWT_EXPIRE_MINUTES=120
JWT_COOKIE_NAME=blog_token
COOKIE_SECURE=false
COOKIE_SAME_SITE=Lax

# ---- 管理员初始化（仅首次启动生效，创建后请从环境变量中移除）----
BLOG_ADMIN_EMAIL=
BLOG_ADMIN_PASSWORD=
BLOG_ADMIN_NICKNAME=Eason

# ---- 功能开关 ----
REGISTER_ENABLED=true

# ---- 跨域（仅本地开发需要，生产同域部署可留空）----
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# ---- 上传目录 ----
UPLOAD_DIR=./data/uploads
