# 统一换行符，避免 Windows 提交后在 Linux/CI 出现整文件 diff
* text=auto

*.java   text eol=lf
*.ts     text eol=lf
*.vue    text eol=lf
*.css    text eol=lf
*.md     text eol=lf
*.yml    text eol=lf
*.yaml   text eol=lf
*.sql    text eol=lf
*.sh     text eol=lf

*.ps1    text eol=crlf
*.bat    text eol=crlf
*.cmd    text eol=crlf

# 二进制文件不做换行转换
*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.ico    binary
*.zip    binary
*.jar    binary
